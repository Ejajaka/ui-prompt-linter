# Copy this file to `.streamlit/secrets.toml` for a hosted deployment.
# Never commit the real secrets file.
#
# Any OpenAI-compatible endpoint works (OpenCode Go, Groq, OpenRouter, OpenAI).
# Without these values the app falls back to deterministic explanations.
#
# Groq:
# LLM_BASE_URL = "https://api.groq.com/openai/v1"
# LLM_MODEL = "openai/gpt-oss-120b"
# LLM_API_KEY = "gsk_..."
#
# OpenCode Go:
# LLM_BASE_URL = "https://opencode.ai/zen/go/v1"
# LLM_MODEL = "deepseek-v4.1-flash"
# LLM_API_KEY = "oc_..."
# LLM_SESSION = "ui-prompt-linter"
#
# Optional: override the BERT model release asset.
# BERT_MODEL_URL = "https://github.com/Ejajaka/ui-prompt-linter/releases/download/model-v1/bert_tagger.zip"
