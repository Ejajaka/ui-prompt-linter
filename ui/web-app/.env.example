# Copy this file to `.env.local` for local development.
# Never commit `.env.local` and never put a service-role/secret key in a VITE_
# variable: VITE_ values are shipped to the browser.

# Supabase public configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional build-time LLM defaults. Production LLM calls must go through a
# server-side Edge Function; do not ship provider keys in production builds.
VITE_VECTOR_TEST_API_KEY=""
