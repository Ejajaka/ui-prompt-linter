{
  "manifest_version": 3,
  "name": "Prompt Linter",
  "version": "1.0.0",
  "description": "Pre-generation completeness review for UI prompts. Detect missing labels, colours, placement and actions before you generate UI.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Prompt Linter",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
